-odontologo.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fteam-ceo-odontologo.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fteam-ceo-odontologo.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fteam-ceo-odontologo.webp&amp;w=1536&amp;q=75\"/></div><div class=\"flex-1\"><span class=\"block font-label text-[10px] tracking-[0.3em] text-[var(--color-brass)] mb-2 uppercase\">CEO / FUNDADOR ODONTÓLOGO</span><h2 class=\"font-display text-2xl md:text-3xl lg:text-4xl text-[var(--color-navy)] mb-3 group-hover:italic transition-all\">Dr. Alejandro V.</h2><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed max-w-md\">Especialista en odontología láser con más de 15 años de experiencia clínica.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"2\" class=\"hairline py-8 md:py-10 group transition-all duration-700\"><div class=\"flex flex-col md:flex-row md:items-center gap-6 md:gap-12\"><div class=\"w-[120px] h-[120px] md:w-[140px] md:h-[140px] shrink-0 overflow-hidden bg-[var(--color-cream)]\"><img alt=\"Ing. Roberto S.\" loading=\"lazy\" width=\"140\" height=\"140\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" style=\"color:transparent\" sizes=\"140px\" srcSet=\"/_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=16&amp;q=75 16w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fteam-coordinator.webp&amp;w=1536&amp;q=75\"/></div><div class=\"flex-1\"><span class=\"block font-label text-[10px] tracking-[0.3em] text-[var(--color-brass)] mb-2 uppercase\">INGENIERO DE SOPORTE</span><h2 class=\"font-display text-2xl md:text-3xl lg:text-4xl text-[var(--color-navy)] mb-3 group-hover:italic transition-all\">Ing. Roberto S.</h2><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed max-w-md\">Certificado en mantenimiento de sistemas fotónicos y protocolos de seguridad láser.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"3\" class=\"hairline py-8 md:py-10 group transition-all duration-700\"><div class=\"flex flex-col md:flex-row md:items-center gap-6 md:gap-12\"><div class=\"w-[120px] h-[120px] md:w-[140px] md:h-[140px] shrink-0 overflow-hidden bg-[var(--color-cream)]\"><img alt=\"Lucía F.\" loading=\"lazy\" width=\"140\" height=\"140\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" style=\"color:transparent\" sizes=\"140px\" srcSet=\"/_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=16&amp;q=75 16w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fteam-tech-lead.avif&amp;w=1536&amp;q=75\"/></div><div class=\"flex-1\"><span class=\"block font-label text-[10px] tracking-[0.3em] text-[var(--color-brass)] mb-2 uppercase\">COORDINADORA DE CAPACITACIONES</span><h2 class=\"font-display text-2xl md:text-3xl lg:text-4xl text-[var(--color-navy)] mb-3 group-hover:italic transition-all\">Lucía F.</h2><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed max-w-md\">Gestión de programas educativos de posgrado para la certificación clínica de especialistas.</p></div></div></div><div class=\"hairline w-full\"></div></div></div></section><section class=\"py-16 md:py-24 bg-[var(--color-cream)]\"><div class=\"container-editorial flex justify-center text-center\"><blockquote data-reveal=\"true\" class=\"max-w-2xl\"><p class=\"font-display italic text-[var(--color-navy)] leading-tight\" style=\"font-size:clamp(1.35rem, 3vw, 2.25rem)\">“Existimos porque la tecnología láser se merece ser explicada, no vendida.”</p></blockquote></div></section><section class=\"py-16 md:py-24\"><div class=\"container-editorial grid grid-cols-12 gap-0 items-start\"><div class=\"col-span-12 lg:col-span-3 mb-10 lg:mb-0\"><div class=\"lg:sticky lg:top-32\"><div class=\"hairline mb-4\"></div><p class=\"caption-label\">Marcas que representamos</p></div></div><div class=\"col-span-12 lg:col-span-9\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10\"><div data-reveal=\"true\" data-reveal-delay=\"1\" class=\"flex flex-col\"><div class=\"h-[160px] bg-[var(--color-cream)] overflow-hidden mb-6\"><img alt=\"Apex Laser\" loading=\"lazy\" width=\"400\" height=\"160\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 768px) 100vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fproduct-dr-smile.webp&amp;w=1536&amp;q=75\"/></div><div class=\"mb-4\"><h3 class=\"font-display text-xl md:text-2xl text-[var(--color-navy)] mb-1\">Apex Laser</h3><span class=\"font-label text-[10px] tracking-[0.2em] text-[var(--color-brass)] uppercase\">Italia</span></div><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed\">Láser de diodo de alta precisión para odontología quirúrgica y terapéutica. Certificación CE europea.</p></div><div data-reveal=\"true\" data-reveal-delay=\"2\" class=\"flex flex-col\"><div class=\"h-[160px] bg-[var(--color-cream)] overflow-hidden mb-6\"><img alt=\"Vitalase\" loading=\"lazy\" width=\"400\" height=\"160\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 768px) 100vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fproduct-quicklase.webp&amp;w=1536&amp;q=75\"/></div><div class=\"mb-4\"><h3 class=\"font-displa