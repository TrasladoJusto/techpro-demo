oogleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"LaserTech\",\"url\":\"https://lasertech-demo.com\",\"description\":\"Distribuidor autorizado de equipos láser odontológicos.\",\"inLanguage\":\"es\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://lasertech-demo.com/equipos?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans flex flex-col min-h-[100dvh]\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[var(--color-blue)] focus:text-white focus:px-4 focus:py-2 focus:outline-none\">Saltar al contenido principal</a><header class=\"hidden md:block fixed top-0 left-0 right-0 z-50 bg-[#FAFBFC]/80 backdrop-blur-md border-b border-[#0A2540]/10\"><nav class=\"flex justify-between items-center w-full px-12 py-6 max-w-[1920px] mx-auto\"><a class=\"font-headline text-2xl font-semibold tracking-tighter text-[#0A2540] hover:opacity-80 transition-opacity\" href=\"/\">LaserTech</a><div class=\"flex items-center gap-12\"><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/equipos\">Tecnología</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/capacitaciones\">Capacitaciones</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/testimonios\">Testimonios</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/servicio-tecnico\">Servicio Técnico</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/nosotros\">Nosotros</a></div><a class=\"font-body text-[11px] uppercase tracking-[0.2em] bg-[#0A2540] text-white px-8 py-3 hover:bg-[#1E5A96] transition-colors duration-500\" href=\"/contacto\">Consulta</a></nav></header><header class=\"md:hidden fixed top-0 left-0 right-0 z-50 bg-[#FAFBFC] border-b border-[#0A2540]/10\"><nav class=\"flex justify-between items-center h-[56px] px-6\"><a class=\"font-headline text-2xl font-semibold tracking-tighter text-[#0A2540]\" href=\"/\">LaserTech</a><button aria-label=\"Abrir menú\" aria-expanded=\"false\" aria-controls=\"mobile-menu-panel\" class=\"min-w-[44px] min-h-[44px] flex items-center justify-center p-2 text-[#0A2540]\"><span class=\"material-symbols-outlined\" style=\"font-variation-settings:&#x27;FILL&#x27; 0, &#x27;wght&#x27; 300, &#x27;GRAD&#x27; 0, &#x27;opsz&#x27; 24\">menu</span></button></nav></header><main id=\"main-content\" class=\"flex-1 relative overflow-x-hidden\"><div class=\"bg-[var(--color-canvas)]\"><section class=\"pt-[72px] md:pt-[80px] pb-24 md:pb-32\"><div class=\"container-editorial grid grid-cols-12 gap-0\"><div class=\"col-span-12 lg:col-span-8 lg:col-start-3\"><p class=\"caption-label text-[var(--color-brass)] mb-6\">Legal</p><h1 data-reveal=\"true\" class=\"font-display italic text-[var(--color-navy)] mb-12\" style=\"font-size:clamp(2rem, 5vw, 3rem)\">Términos y Condiciones</h1><div class=\"space-y-12\"><div data-reveal=\"true\" data-reveal-delay=\"1\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">1. Aceptación de los términos</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Al acceder y utilizar el sitio web de Endovita Technology (endovitatechnology.com), usted acepta estos términos y condiciones en su totalidad. Si no está de acuerdo con alguno de estos términos, no debe utilizar nuestro sitio web.</p></div><div data-reveal=\"true\" data-reveal-delay=\"2\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">2. Servicios</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Endovita Technology S.A.C. es distribuidor oficial de equipos láser odontológicos Dr. Smile (Italia) y Quicklase (Brasil) en Perú. Los precios mostrados son de referencia y pueden variar. Las cotizaciones formales se proporcionan previa evaluación técnica del caso clínico.</p></div><div data-reveal=\"true\" data-reveal-delay=\"3\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">3. Propiedad intelectual</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Todo el contenido de este sitio web, incluyendo textos, imágenes, logotipos, gráficos y diseños, es propiedad de Endovita Technology o de sus proveedores y está protegido por las leyes de propiedad intelectual de Perú.</p></div><div data-reveal=\"true\" data-reveal-delay=\"4\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">4. Garantía y soporte</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Los equipos cuentan con garantía directa del fabricante. El soporte técnico es proporcionado directamente por Endovita Technology. Las condiciones específicas de garantía se detallan en cada cotización y contrato de venta.</p></div><div data-reveal=\"true\" data-reveal-delay=\"5\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">5. Limitación de responsabilidad</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Endovita Technology no se hace responsable por el uso indebido de los equipos láser. La capacitación clínica es un requisito previo para el uso de cualquier equipo distribuido por nuestra empresa.</p></div><div data-reveal=\"true\" data-reveal-delay=\"6\"><h2 class=\"font-display text-xl text-[var(--color-navy)] mb-4\">6. Legislación aplicable</h2><p class=\"font-body text-[14px] text-[var(--color-muted)] leading-relaxed\">Estos términos se rigen por las leyes de la República del Perú. Cualquier disputa será sometida a los tribunales competentes de la ciudad de Lima, Perú.</p></div></div><div class=\"mt-16 pt-8 border-t border-[var(--color-rule)]\"><p class=\"font-label text-[10px] tracking-[0.15em] text-[var(--color-subtle)]\">Última actualización: julio 2026</p></div><div class=\"mt-8\"><a class=\"cta-link text-[13px]\" href=\"/\">Volver al inicio<span class=\"arrow\">→</span></a></div></div></div></section></div><!--$--><!--/$--></main><footer class=\"bg-[#F8F5F0] px-6 md:px-12 py-16 md:py-20 w-full\"><div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-8 max-w-[1920px] mx-auto\"><div class=\"md:col-span-4\"><p class=\"font-headline text-xl text-[#0A2540] mb-6 md:mb-8\">LaserTech</p><p class=\"font-body text-[11px] uppercase tracking-[0.2em] opacity-60 max-w-xs leading-relaxed\">Surgical Excellence in Dental Innovation. Distribuidor autorizado para el mercado sudamericano.</p></div><div class=\"md:col-span-8 flex flex-col justify-end\"><div class=\"flex flex-wrap gap-6 md:gap-12 mb-8 md:mb-12\"><a class=\"font-body text-[11px] uppercase tracking-[0.2em] hover:text-[#1E5A96] transition-colors\" href=\"/privacidad\">Regulatory Compliance</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] hover:text-[#1E5A96] transition-colors\" href=\"/privacidad#aviso\">Privacy Policy</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] hover:text-[#1E5A96] transition-colors\" href=\"/servicio-tecnico\">Service &amp; Support</a></div><div class=\"flex flex-col md:flex-row justify-between items-start md:items-center border-t border-[#0A2540]/10 pt-6 md:pt-8 gap-4\"><p class=\"font-body text-[11px] uppercase tracking-[0.2em] opacity-40\">© <!-- -->2026<!-- --> LaserTech. Lima, Peru.</p><div class=\"flex gap-4\"><span class=\"w-2 h-2 rounded-full bg-[#D4A574]\"></span><span class=\"w-2 h-2 rounded-full bg-[#0A2540]/20\"></span><span class=\"w-2 h-2 rounded-full bg-[#0A2540]/20\"></span></div></div></div></div></footer><script src=\"/_next/static/chunks/webpack-0c84330fce50e743.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[1398,[\\\"592\\\",\\\"static/chunks/c15bf2b0-52e8419f34af26ab.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"217\\\",\\\"static/chunks/217-6a4277b9f6fc5be4.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-3d833332fb402778.js\\\"],\\\"default\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[2619,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"900\\\",\\\"static/chunks/app/terminos/page-b0d9aecc822f2394.js\\\"],\\\"\\\"]\\nd:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/22a5144ee8d83bca-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/5611c55482296524-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/7d4881bb7e1bf84d-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/css/033e41eadd9884f3.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"Wxmw8yhF9VGkWM9CUzoNS\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"terminos\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"terminos\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/033e41eadd9884f3.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\"