t.svg\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.svg\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"LaserTech\",\"url\":\"https://lasertech-demo.com\",\"description\":\"Distribuidor autorizado de equipos láser odontológicos.\",\"inLanguage\":\"es\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://lasertech-demo.com/equipos?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans flex flex-col min-h-[100dvh]\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[var(--color-blue)] focus:text-white focus:px-4 focus:py-2 focus:outline-none\">Saltar al contenido principal</a><header class=\"hidden md:block fixed top-0 left-0 right-0 z-50 bg-[#FAFBFC]/80 backdrop-blur-md border-b border-[#0A2540]/10\"><nav class=\"flex justify-between items-center w-full px-12 py-6 max-w-[1920px] mx-auto\"><a class=\"font-headline text-2xl font-semibold tracking-tighter text-[#0A2540] hover:opacity-80 transition-opacity\" href=\"/\">LaserTech</a><div class=\"flex items-center gap-12\"><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/equipos\">Tecnología</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/capacitaciones\">Capacitaciones</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/testimonios\">Testimonios</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/servicio-tecnico\">Servicio Técnico</a><a class=\"font-body text-[11px] uppercase tracking-[0.2em] text-[#0A2540] opacity-70 hover:opacity-100 transition-all duration-500\" href=\"/nosotros\">Nosotros</a></div><a class=\"font-body text-[11px] uppercase tracking-[0.2em] bg-[#0A2540] text-white px-8 py-3 hover:bg-[#1E5A96] transition-colors duration-500\" href=\"/contacto\">Consulta</a></nav></header><header class=\"md:hidden fixed top-0 left-0 right-0 z-50 bg-[#FAFBFC] border-b border-[#0A2540]/10\"><nav class=\"flex justify-between items-center h-[56px] px-6\"><a class=\"font-headline text-2xl font-semibold tracking-tighter text-[#0A2540]\" href=\"/\">LaserTech</a><button aria-label=\"Abrir menú\" aria-expanded=\"false\" aria-controls=\"mobile-menu-panel\" class=\"min-w-[44px] min-h-[44px] flex items-center justify-center p-2 text-[#0A2540]\"><span class=\"material-symbols-outlined\" style=\"font-variation-settings:&#x27;FILL&#x27; 0, &#x27;wght&#x27; 300, &#x27;GRAD&#x27; 0, &#x27;opsz&#x27; 24\">menu</span></button></nav></header><main id=\"main-content\" class=\"flex-1 relative overflow-x-hidden\"><div class=\"bg-[var(--color-canvas)] overflow-x-hidden\"><section class=\"pt-[72px] md:pt-[80px] pb-8 md:pb-12\"><div class=\"container-editorial grid grid-cols-12 gap-0 items-end\"><div class=\"col-span-12 lg:col-span-8\"><p class=\"caption-label text-[var(--color-brass)] mb-4 md:mb-6\">01 — Soporte</p><h1 data-reveal=\"true\" class=\"font-display leading-[0.95] tracking-[-0.03em] max-w-4xl\" style=\"font-size:clamp(2.25rem, 6vw, 4.5rem)\">Soporte técnico directo del fabricante.</h1></div><div class=\"hidden lg:block col-span-4\"><div class=\"h-[160px] overflow-hidden\"><img alt=\"Soporte técnico LaserTech\" loading=\"lazy\" width=\"400\" height=\"160\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover\" style=\"color:transparent\" sizes=\"33vw\" srcSet=\"/_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fsupport-tech.webp&amp;w=1536&amp;q=75\"/></div></div></div></section><section class=\"pb-16 md:pb-24\"><div class=\"container-editorial grid grid-cols-12 gap-0 items-start\"><div class=\"col-span-12 md:col-span-6 mb-12 md:mb-0\"><div class=\"space-y-0\"><div data-reveal=\"true\" data-reveal-delay=\"1\" class=\"hairline py-8 md:py-10 group\"><div class=\"flex items-baseline gap-5\"><span class=\"font-display text-xl italic text-[var(--color-navy)]/40 shrink-0\">01<!-- -->.</span><div class=\"flex-1\"><h3 class=\"font-display text-lg md:text-xl lg:text-2xl mb-3 text-[var(--color-navy)]\">Respuesta inicial &lt;24h hábiles</h3><p class=\"font-body text-[13px] text-[var(--color-navy)]/70 leading-relaxed max-w-md\">Priorizamos la continuidad operativa de su clínica con diagnósticos remotos inmediatos para maximizar el Clinical Uptime.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"2\" class=\"hairline py-8 md:py-10 group\"><div class=\"flex items-baseline gap-5\"><span class=\"font-display text-xl italic text-[var(--color-navy)]/40 shrink-0\">02<!-- -->.</span><div class=\"flex-1\"><h3 class=\"font-display text-lg md:text-xl lg:text-2xl mb-3 text-[var(--color-navy)]\">Garantía directa Italia/Brasil</h3><p class=\"font-body text-[13px] text-[var(--color-navy)]/70 leading-relaxed max-w-md\">Protección integral respaldada por los fabricantes originales, asegurando una cobertura sin intermediarios ni demoras burocráticas.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"3\" class=\"hairline py-8 md:py-10 group\"><div class=\"flex items-baseline gap-5\"><span class=\"font-display text-xl italic text-[var(--color-navy)]/40 shrink-0\">03<!-- -->.</span><div class=\"flex-1\"><h3 class=\"font-display text-lg md:text-xl lg:text-2xl mb-3 text-[var(--color-navy)]\">Repuestos originales</h3><p class=\"font-body text-[13px] text-[var(--color-navy)]/70 leading-relaxed max-w-md\">Integridad de componentes garantizada mediante calibración láser certificada y piezas de ingeniería de alta precisión.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"4\" class=\"hairline py-8 md:py-10 group\"><div class=\"flex items-baseline gap-5\"><span class=\"font-display text-xl italic text-[var(--color-navy)]/40 shrink-0\">04<!-- -->.</span><div class=\"flex-1\"><h3 class=\"font-display text-lg md:text-xl lg:text-2xl mb-3 text-[var(--color-navy)]\">Mantenimiento preventivo programado</h3><p class=\"font-body text-[13px] text-[var(--color-navy)]/70 leading-relaxed max-w-md\">Protocolos de revisión trimestral para prevenir fallos y extender la vida útil del equipo más allá de 10 años.</p></div></div></div><div data-reveal=\"true\" data-reveal-delay=\"5\" class=\"hairline py-8 md:py-10 group\"><div class=\"flex items-baseline gap-5\"><span class=\"font-display text-xl italic text-[var(--color-navy)]/40 shrink-0\">05<!-- -->.</span><div class=\"flex-1\"><h3 class=\"font-display text-lg md:text-xl lg:text-2xl mb-3 text-[var(--color-navy)]\">Soporte remoto en tiempo real</h3><p class=\"font-body text-[13px] text-[var(--color-navy)]/70 leading-relaxed max-w-md\">Diagnóstico asistido por videoconferencia para resolución inmediata de problemas de configuración y protocolo.</p></div></div></div></div></div><div class=\"col-span-12 md:col-span-5 md:col-start-8 md:sticky md:top-24\"><div class=\"mb-10\"><p class=\"caption-label text-[var(--color-brass)] mb-4\">Solicitud de soporte</p><h2 class=\"font-display text-xl md:text-2xl text-[var(--color-navy)] mb-3\">Cuéntanos tu problema técnico.</h2><p class=\"font-body text-[13px] text-[var(--color-muted)]\">Nuestro equipo evaluará tu caso y responderá con un diagnóstico preliminar en menos de 24 horas hábiles.</p></div><form class=\"space-y-10\"><div class=\"space-y-2\"><label for=\"soporte-nombre\" class=\"field-label\">Nombre *</label><input id=\"soporte-nombre\" type=\"text\" required=\"\" class=\"field-input \" placeholder=\"Tu nombre\" name=\"nombre\"/></div><div class=\"space-y-2\"><label for=\"soporte-email\" class=\"field-label\">Email *</label><input id=\"soporte-email\" type=\"email\" required=\"\" class=\"field-input \" placeholder=\"tu@email.com\" name=\"email\"/></div><div class=\"space-y-2\"><label for=\"soporte-telefono\" class=\"field-label\">Teléfono *</label><input id=\"soporte-telefono\" type=\"tel\" required=\"\" class=\"field-input \" placeholder=\"999 888 777\" name=\"telefono\"/></div><div class=\"space-y-2\"><label for=\"soporte-modelo\" class=\"field-label\">Modelo del equipo *</label><select id=\"soporte-modelo\" name=\"modelo\" required=\"\" class=\"field-input appearance-none\"><option value=\"\">Seleccionar modelo</option><option value=\"precision-3w\">Precision 3W</option><option value=\"simpler-980\">SIMPLER 980</option><option value=\"biostim-635\">BioStim 635</option><option value=\"dual-pro\">Dual Pro</option><option value=\"duo-810-980\">Duo 810/980</option><option value=\"otro\">Otro (especificar abajo)</option></select></div><div class=\"space-y-2\"><label for=\"soporte-urgencia\" class=\"field-label\">Urgencia</label><select id=\"soporte-urgencia\" name=\"urgencia\" class=\"field-input appearance-none\"><option value=\"low\">Baja — Puedo esperar</option><option value=\"medium\" selected=\"\">Media — Necesito respuesta pronto</option><option value=\"high\">Alta — El equipo está parado</option><option value=\"emergency\">Emergencia — Urgente</option></select></div><div class=\"space-y-2\"><label for=\"soporte-descripcion\" class=\"field-label\">Describe el problema *</label><textarea id=\"soporte-descripcion\" name=\"descripcion\" required=\"\" rows=\"5\" class=\"field-input resize-none \" placeholder=\"Cuéntanos qué está pasando con tu equipo. Incluye detalles como cuándo empezó el problema, si muestra algún mensaje de error, etc.\"></textarea></div><input type=\"text\" tabindex=\"-1\" autoComplete=\"off\" class=\"hidden\" aria-hidden=\"true\" name=\"website_url\"/><div class=\"pt-4\"><button type=\"submit\" class=\"cta-link text-[15px]\">Enviar solicitud<span class=\"arrow\">→</span></button></div></form><div class=\"mt-12 pt-6 border-t border-[var(--color-rule)]\"><p class=\"font-label text-[10px] leading-relaxed text-[var(--color-navy)]/40 max-w-xs\">Para emergencias clínicas fuera del horario laboral, contacte directamente al +51 932 433 154.</p></div></div></div></section><section class=\"pb-16 md:pb-24\"><div class=\"container-editorial\"><div class=\"w-full h-[200px] md:h-[350px] overflow-hidden\"><img alt=\"Soporte técnico de equipo láser dental\" loading=\"lazy\" width=\"512\" height=\"279\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-full object-cover\" style=\"color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=768&amp;q=75 768w, /_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=1024&amp;q=75 1024w, /_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=1536&amp;q=75 1536w\" src=\"/_next/image?url=%2Fimages%2Fstitch%2Fservicio-clinical.webp&amp;w=1536&amp;q=75\"/></div></div></section><section class=\"py-16 md:py-24 bg-[var(--color-cream)]\"><div class=\"container-editorial\"><h2 class=\"caption-label mb-10\">Preguntas frecuentes</h2><div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10\"><div data-reveal=\"true\" data-reveal-delay=\"1\"><h3 class=\"font-display text-lg text-[var(--color-navy)] mb-3\">¿Cuánto tiempo dura la garantía?</h3><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed\">La garantía estándar es de 24 meses para equipos nuevos, con opción de extensión a 36 meses. Equipos reacondicionados incluyen 12 meses de garantía completa.</p></div><div data-reveal=\"true\" data-reveal-delay=\"2\"><h3 class=\"font-display text-lg text-[var(--color-navy)] mb-3\">¿Pueden reparar equipos de otras marcas?</h3><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed\">Nuestro servicio técnico especializado cubre exclusivamente las marcas que distribuimos: Apex Laser y Vitalase. Para otros equipos, podemos ofrecer orientación.</p></div><div data-reveal=\"true\" data-reveal-delay=\"3\"><h3 class=\"font-display text-lg text-[var(--color-navy)] mb-3\">¿La capacitación inicial está incluida?</h3><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed\">Sí. Todo equipo nuevo incluye una sesión de capacitación presencial de 4 horas en sus instalaciones, más material de protocolo clínico impreso y digital.</p></div><div data-reveal=\"true\" data-reveal-delay=\"4\"><h3 class=\"font-display text-lg text-[var(--color-navy)] mb-3\">¿Cómo solicito servicio técnico?</h3><p class=\"font-body text-[13px] text-[var(--color-muted)] leading-relaxed\">Puede comunicarse al +51 999 888 777 o enviar un email a demo@lasertech-demo.com. Respondemos en menos de 24 horas hábiles con un diagnóstico preliminar.</p></div></div></div></section><section class=\"bg-[var(--color-navy)] py-20 md:py-28\"><div class=\"container-editorial text-center flex flex-col items-center\"><p data-reveal=\"true\" class=\"caption-label !text-[var(--color-paper)]/40 mb-4 md:mb-6\">¿Necesitas soport